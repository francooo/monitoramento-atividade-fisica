# Neon — Dashboard > Project > Connection string (Pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/dawn?sslmode=require"

# Neon — Direct (unpooled) connection. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/dawn?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Google OAuth — console.cloud.google.com > APIs e Serviços > Credenciais.
# Sem estas duas, o app sobe normalmente e só o botão "Continuar com Google"
# fica indisponível. O redirect URI a cadastrar no console é
# <origem>/api/auth/google/callback — um para cada origem que for usar
# (http://localhost:3000 e o domínio de produção).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
